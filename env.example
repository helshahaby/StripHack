# ─── PropVoice Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is listed in .gitignore.

# ── Database (from Railway or Supabase dashboard) ──────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."

# Webhook 1 — Your platform account (dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Webhook 2 — Connected accounts (for Landlord/Vendor onboarding events)
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."

# ── ElevenLabs ─────────────────────────────────────────────────────────────────
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY="sk_..."
ELEVENLABS_AGENT_ID="agent_..."

# Webhook signing key (set this in ElevenLabs dashboard → Webhooks)
ELEVENLABS_WEBHOOK_SECRET="PropVoiceSecret2026!"

# ── App ────────────────────────────────────────────────────────────────────────
# Your Railway public URL (auto-set by Railway, override for local dev)
APP_URL="https://your-app.up.railway.app"
PORT=3000
NODE_ENV="production"

# ── Optional: Notifications (add later) ───────────────────────────────────────
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE_NUMBER="+1..."
# SENDGRID_API_KEY="SG..."
